<?xml version="1.0" encoding="utf-8"?>
<!--
    缓存里可能含私有代码与文档，因此云端备份与设备间迁移一律排除。
    allowBackup=false 已挡住 adb backup，这里再挡住 Android 12+ 的 D2D 通道。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
